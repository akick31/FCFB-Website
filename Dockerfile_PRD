# Stage 1: Build the React app
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

ENV NODE_OPTIONS=--max_old_space_size=1024
ENV GENERATE_SOURCEMAP=false
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:1.27-alpine

RUN apk add --no-cache nodejs

ENV BACKEND_BASE_URL=http://172.17.0.1:1212/api/v1/arceus

COPY --from=build /app/build /usr/share/nginx/html
COPY nginx/prd.conf.template /etc/nginx/templates/default.conf.template
COPY og-meta/server.js /app/og-meta/server.js
COPY nginx/50-start-og-meta.sh /docker-entrypoint.d/50-start-og-meta.sh
RUN chmod +x /docker-entrypoint.d/50-start-og-meta.sh

EXPOSE 462
